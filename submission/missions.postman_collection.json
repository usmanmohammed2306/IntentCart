{
  "info": {
    "name": "IntentCart Missions \u2014 local no-payment walkthrough",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "No provider/payment requests. Uses fictional specification fixtures. Start a local server, import and run in order. Cookies stay local; do not publish exported session values."
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:4000"
    },
    {
      "key": "csrf",
      "value": ""
    },
    {
      "key": "revision",
      "value": ""
    },
    {
      "key": "quote_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Create owned session",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/session"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Session created', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('csrf', pm.response.json().csrf_token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Compile a complete workstation",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Origin",
            "value": "{{base_url}}"
          },
          {
            "key": "x-csrf-token",
            "value": "{{csrf}}"
          }
        ],
        "url": "{{base_url}}/api/missions",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"text\": \"Build a dual-monitor workspace under $350\",\n  \"goal\": {\n    \"laptop_id\": \"studio-pro\",\n    \"budget_cents\": 35000,\n    \"displays\": 2,\n    \"height\": 1080,\n    \"hz\": 60,\n    \"reuse_monitor\": true,\n    \"allow_driver\": false\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Plan compiled', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('revision', pm.response.json().revision);",
              "pm.test('Ready', () => pm.expect(pm.response.json().result.status).to.eql('READY'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Inspect relevant missing fixtures",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Origin",
            "value": "{{base_url}}"
          },
          {
            "key": "x-csrf-token",
            "value": "{{csrf}}"
          }
        ],
        "url": "{{base_url}}/api/missions/investigate",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"revision\": {{revision}}\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Inspected', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('revision', pm.response.json().revision);"
            ]
          }
        }
      ]
    },
    {
      "name": "Freeze exact sandbox quote",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Origin",
            "value": "{{base_url}}"
          },
          {
            "key": "x-csrf-token",
            "value": "{{csrf}}"
          }
        ],
        "url": "{{base_url}}/api/missions/quotes",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"revision\": {{revision}}\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Quote created', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('quote_id', pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Inspect owned decision receipt",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/decision-receipt/{{quote_id}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('No order or consent', () => {const r=pm.response.json(); pm.expect(r.order_status).to.eql('NO_ORDER'); pm.expect(r.current_checks.failed).to.include('consent');});"
            ]
          }
        }
      ]
    }
  ]
}
