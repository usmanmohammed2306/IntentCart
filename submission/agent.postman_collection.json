{
  "info": {
    "name": "IntentCart 4.2 Evidence Agent \u2014 local only, no payment or inference",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:4000"
    },
    {
      "key": "csrf",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Start session",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/session"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP succeeds\", function () { pm.response.to.have.status(200); });",
              "pm.collectionVariables.set(\"csrf\", pm.response.json().csrf_token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Read curated collection",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/agent/catalog"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP succeeds\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Start reviewed evidence task",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Origin",
            "value": "{{baseUrl}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-CSRF-Token",
            "value": "{{csrf}}"
          }
        ],
        "url": "{{baseUrl}}/api/agent",
        "body": {
          "mode": "raw",
          "raw": "{\"goal\": {}, \"scenario_confirmed\": false}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP succeeds\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Read owned task",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/agent"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP succeeds\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Read matched local results",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/agent/evaluation"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP succeeds\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    }
  ]
}
