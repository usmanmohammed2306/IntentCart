# No credentials are needed for local learning, evaluation, or checkout preview.
PUBLIC_URL=http://127.0.0.1:4000
DATABASE_PATH=var/intentcart.sqlite3
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
CHANNEL3_API_KEY=
# This durable per-installation limit bounds optional Channel3 calls, including failures.
EXTERNAL_CALL_LIMIT=0
COOKIE_SECURE=false

# Optional Astropods interpreter. Zero calls/budget by default. Never add secrets to Git.
ASTRO_GATEWAY_URL=
ASTRO_GATEWAY_API_KEY=
MODEL_DEFAULT=claude-haiku-4-5
ASTRO_CREDIT_ONLY_CONFIRMED=false
ASTRO_BUDGET_MICROUSD=0
# Operator-reviewed maximum rates; not supplied or assumed by this repository.
ASTRO_INPUT_MICROUSD_PER_MILLION=0
ASTRO_OUTPUT_MICROUSD_PER_MILLION=0
